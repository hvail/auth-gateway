<!DOCTYPE html>
<html>

<head>
    <title>Authorization Result</title>
</head>

<body>
    <h1>Authorization Result</h1>
    <p>Thank you for authorizing the application.</p>

    <script>
        var dataStr = "<%= data %>".replace(/&#(\d+);/g, (match, dec) => {
            return String.fromCharCode(dec);
        });
        console.log(dataStr); 
        var data = JSON.parse(dataStr); 
        console.log(data); 
    </script>
</body>

</html>